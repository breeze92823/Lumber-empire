# Dev only: the local game server (Lumber-empire-backend, npm start). Defaults to ws://localhost:2567.
# Built games never read it: they always go through the Bloxity matchmaker.
# VITE_SERVER_URL_DEV=ws://localhost:2567

# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false
# With VITE_DEV_MODE=true the dev server (npm run dev) also gives unlimited money, for local testing.
# Production builds ignore it.
